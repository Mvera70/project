{
  "name": "the-valley",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Valley — idle simulation of a medieval village. See docs/design.md.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:journeys": "vitest run --config vitest.journeys.config.ts",
    "test:all": "npm test && npm run test:journeys",
    "test:balance": "vitest run --config vitest.balance.config.ts",
    "chronicle": "tsx src/cli/chronicle.ts",
    "shots": "tsx tools/screenshots.ts",
    "shot": "tsx tools/graphics/bundle-game.ts && node tools/graphics/shot.mjs",
    "serve:shots": "node tools/graphics/serve.mjs",
    "bundle": "tsx tools/graphics/bundle-game.ts",
    "assets:publish": "tsx tools/graphics/publish-assets.ts",
    "art": "tsx tools/art/index.ts",
    "eligibility": "tsx tools/eligibility-report.ts",
    "balance:report": "tsx tools/balance-report.ts",
    "test:shots": "playwright test --config playwright.config.ts",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "icons": "tsx tools/icons.ts",
    "lint": "eslint .",
    "map": "tsx tools/map-dump.ts",
    "attribution": "tsx tools/attribution-report.ts",
    "policy:attribution": "tsx tools/policy-attribution-report.ts",
    "migration:ab": "tsx tools/migration-ab-report.ts",
    "reader:packet": "tsx tools/reader-packet.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/three": "0.185.4",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "three": "0.185.0"
  }
}
